# Database (SQLite — cwd-relative path)
DATABASE_URL="file:./prisma/dev.db"

# Mentorship LLM provider: gemini | openai | anthropic
# Default is gemini (free-tier friendly). Swap later by changing AI_PROVIDER + key.
AI_PROVIDER=gemini

# Gemini (default) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# OpenAI (optional — set AI_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional — set AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: personal LeetCode stats (not required for public problem fetch)
LEETCODE_SESSION=
LEETCODE_CSRF=

# Cache
PROBLEM_CACHE_TTL_HOURS=24

# Code runner — sibling algora-runner (Docker), not the public Piston API
# Local: http://127.0.0.1:2000/api/v2  (use 2001 if PORT in algora-runner .env is 2001)
EXECUTOR_URL=http://127.0.0.1:2000/api/v2
# Same value as algora-runner RUNNER_TOKEN (required for Run/Submit):
EXECUTOR_TOKEN=dev-secret
# Uncomment to force Run/Submit off. If unset and the runner is down, the Code tab disables the buttons after a health ping.
# EXECUTOR_DISABLED=1
# EXECUTOR_GAP_MS=250
