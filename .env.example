# Database (SQLite — file resolves under prisma/)
DATABASE_URL="file:./dev.db"

# Mentorship LLM provider: gemini | openai | anthropic
# Default is gemini (free-tier friendly). Swap later by changing AI_PROVIDER + key.
AI_PROVIDER=gemini

# Gemini (default) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional — set AI_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional — set AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: personal LeetCode stats (not required for public problem fetch)
LEETCODE_SESSION=
LEETCODE_CSRF=

# Cache
PROBLEM_CACHE_TTL_HOURS=24
